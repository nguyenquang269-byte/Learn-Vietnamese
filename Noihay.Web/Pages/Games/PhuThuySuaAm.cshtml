@page
@model Noihay.Web.Pages.Games.PhuThuySuaAmModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Phù thủy sửa âm 🧙";
}

<div class="game-immersive bg-sky-blue overflow-hidden position-relative" style="height: 100vh; margin-top: -80px;">
    <!-- Game Background -->
    <div class="clouds-decor">
        <div class="cloud-1 position-absolute top-10 start-10 float-anim">☁️</div>
        <div class="cloud-2 position-absolute top-20 end-20 float-anim" style="animation-delay: 1s;">☁️</div>
    </div>

    <!-- Heart/Ice Cream Health -->
    <div class="game-ui-top position-absolute top-0 start-50 translate-middle-x p-4 d-flex gap-2">
        <span class="heart fs-2">🍦</span>
        <span class="heart fs-2">🍦</span>
        <span class="heart fs-2">🍦</span>
    </div>

    <!-- Main Game Area -->
    <div class="container h-100 d-flex flex-column justify-content-center align-items-center">
        <div id="game-stage" class="position-relative mb-5" style="width: 100%; height: 300px;">
            <!-- Dino Character -->
            <div id="dino-char" class="position-absolute bottom-0 start-0 transition-all" style="left: 100px; font-size: 80px;">🦖</div>
            
            <!-- Obstacle -->
            <div id="obstacle" class="position-absolute bottom-0" style="right: 200px; font-size: 60px;">🌵</div>
        </div>

        <!-- Instruction / Target Word -->
        <div class="word-card p-5 bg-white rounded-marshmallow shadow-pastel text-center" style="min-width: 400px;">
            <p class="text-muted mb-2">Đọc to "Mật mã" để Dino nhảy qua nào!</p>
            <h1 id="target-text" class="display-1 font-weight-bold text-primary-dino mb-4">...</h1>
            
            <button id="mic-btn" class="btn btn-warning-dino p-4 rounded-circle shadow-lg pulse-anim">
                <i class="bi bi-mic-fill fs-1"></i>
            </button>
            <div id="feedback" class="mt-4 h4 text-success font-weight-bold"></div>
        </div>
    </div>

    <!-- Exit Game -->
    <a asp-page="/Index" class="btn btn-secondary rounded-pill position-absolute top-0 start-0 m-4">Thoát Game</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
<script>
    const words = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TargetWords));
    let currentIndex = 0;
    
    function nextLevel() {
        if (currentIndex >= words.length) {
            alert("Bé đã thắng cuộc rồi! Giỏi quá! 🏆");
            window.location.href = "/Index";
            return;
        }
        document.getElementById('target-text').innerText = words[currentIndex].text;
        document.getElementById('feedback').innerText = "";
        
        // Move obstacle
        document.getElementById('obstacle').style.right = (Math.random() * 50 + 20) + "%";
    }

    document.getElementById('mic-btn').onclick = async function() {
        this.classList.add('pulse-recording');
        document.getElementById('feedback').innerText = "Đang lắng nghe...";
        
        const targetWord = words[currentIndex].text;
        
        // Mock recognition for now (real STT can be added here)
        try {
            const response = await fetch(`?handler=Evaluate&text=${encodeURIComponent(targetWord)}`);
            const result = await response.json();
            
            if (result.isCorrect) {
                // Dino Jump
                const dino = document.getElementById('dino-char');
                dino.style.transform = "translateY(-150px)";
                setTimeout(() => dino.style.transform = "translateY(0px)", 500);
                
                document.getElementById('feedback').innerText = result.feedback;
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: ['#4D96FF', '#FF8BA7', '#FFB72B']
                });
                
                currentIndex++;
                setTimeout(nextLevel, 2000);
            } else {
                document.getElementById('feedback').innerText = "Bé đọc lại nhé! 💪";
                document.getElementById('feedback').style.color = "#FF9800";
            }
        } catch (e) {
            console.error(e);
        }
        
        this.classList.remove('pulse-recording');
    };

    window.onload = nextLevel;
</script>

<style>
    .game-immersive {
        background: linear-gradient(to bottom, #EBF4FF 0%, #F9FBF2 100%);
    }
    .pulse-recording {
        animation: pulse-red 1s infinite;
    }
    @@keyframes pulse-red {
        0% { box-shadow: 0 0 0 0 rgba(255, 107, 107, 0.7); }
        70% { box-shadow: 0 0 0 20px rgba(255, 107, 107, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 107, 107, 0); }
    }
</style>
